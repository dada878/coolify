# Build from the same Coolify release as this branch. The patch only changes
# the Projects page and its read-only status query.
FROM coollabsio/coolify:4.6.0@sha256:8821fbb5d1eb083a7378d9c0f6c85eae56ba0171b69947ebcb415eb8133706d7
COPY --chown=www-data:www-data app/Livewire/Project/Index.php /var/www/html/app/Livewire/Project/
COPY --chown=www-data:www-data app/Services/EnvironmentCanvas.php app/Services/ProjectRuntimeStatus.php /var/www/html/app/Services/
COPY --chown=www-data:www-data resources/views/livewire/project/index.blade.php resources/views/livewire/project/runtime-badge.blade.php /var/www/html/resources/views/livewire/project/
